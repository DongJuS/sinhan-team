# Local demo only; no external payment calls are made.
POSTGRES_PASSWORD=postgres-dev-only
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
ORDERS_DB_PASSWORD=orders_dev_only
AGENT_DB_PASSWORD=agent_dev_only
BENEFITS_DB_PASSWORD=benefits_dev_only
CONTROL_DB_PASSWORD=control_dev_only
PAYMENTS_DB_PASSWORD=payments_dev_only
KEYCLOAK_DB_PASSWORD=keycloak_dev_only
ENABLE_FAULTS=false
# LangGraph orchestrates the Agent; inference runs on the host Mac with Ollama.
AI_MODE=local
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_MODEL=sinhan-qwen:14b-q8_0
# Empty uses local keyword RAG. Optional local embedding model is separately indexed.
RAG_EMBEDDING_MODEL=
